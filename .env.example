# ==========================================================
# 复制本文件为 .env 后填写真实值（.env 已在 .gitignore 中被忽略）
# 命令： cp .env.example .env
# ==========================================================

# ---- 大模型配置（DeepSeek，OpenAI 兼容协议）----
# 去 https://platform.deepseek.com/api_keys 申请
LLM_API_KEY=sk-在这里填你的Key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：温度越低输出越稳定，生成测试用例建议 0.1~0.3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# 设为 true 可强制走离线 Mock，不花钱也能跑通流程
LLM_MOCK=false

# ---- 关联的已有测试项目（只读引用，本项目不会修改它）----
TEST_PROJECT_DIR=D:/PythonProjects/ecommerce-test-automation

# ---- 日志级别：DEBUG / INFO / WARNING / ERROR ----
LOG_LEVEL=INFO
